# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.agents
.claude
skills-lock.json

# playwright
/test-results/

# superpowers workflow scratch state (ledgers, task briefs, review diffs)
.superpowers/

# design docs (specs/plans) — kept locally, not tracked in git
docs/

# ingested email attachments — stored on disk, not tracked in git
/storage/