DATABASE_URL=postgres://support_hub:support_hub@localhost:5432/support_hub
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000
# Platform login OAuth (agent/admin sign-in) — a bootstrap dependency, so
# it lives here rather than the encrypted app_secrets store.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte (64 hex character) key used to encrypt admin-managed integration
# credentials (e.g. the Microsoft Graph mailbox connection, added in the
# Ticket Ingestion phase) stored in the app_secrets table. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Directory where ingested email attachments are stored (mount as a Docker
# volume in production so they persist across deploys). Defaults to
# ./storage/attachments if unset.
ATTACHMENTS_DIR=
