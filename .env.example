DATABASE_URL=postgres://support_hub:support_hub@localhost:5432/support_hub
# Connection string for the isolated database Vitest and Playwright run
# against, so `pnpm test` / `pnpm test:e2e` never touch real data in
# DATABASE_URL. Must name a different database. `docker/init-db.sql` creates
# it automatically on a fresh volume; on an existing one, create it once:
#   docker compose exec postgres psql -U support_hub -d support_hub -c "CREATE DATABASE support_hub_test;"
#   docker compose exec postgres psql -U support_hub -d support_hub_test -c "CREATE EXTENSION IF NOT EXISTS vector;"
# then apply migrations to it with `pnpm db:migrate:test`.
TEST_DATABASE_URL=postgres://support_hub:support_hub@localhost:5432/support_hub_test
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000
# Platform login OAuth (agent/admin sign-in) — a bootstrap dependency, so
# it lives here rather than the encrypted app_secrets store.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte (64 hex character) key used to encrypt admin-managed integration
# credentials (e.g. the Microsoft Graph mailbox connection, added in the
# Ticket Ingestion phase) stored in the app_secrets table. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Directory where ingested email attachments are stored (mount as a Docker
# volume in production so they persist across deploys). Defaults to
# ./storage/attachments if unset.
ATTACHMENTS_DIR=
# Shared secret the external scheduler (system cron / Task Scheduler / a
# small script) must send as the x-cron-secret header when calling
# /api/cron/poll-mailbox. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Where uploaded knowledge base documents are written.
KB_STORAGE_DIR=./storage/kb
